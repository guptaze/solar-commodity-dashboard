# Copy to .env and fill in what you have. Everything is optional — the app
# falls back to free scraped/delayed sources when a key is absent.

# --- LME price sources (pick one or more; first that responds wins) ---
# Nasdaq Data Link (formerly Quandl) - LME dataset access
NASDAQ_DATA_LINK_API_KEY=

# Alpha Vantage - used as a secondary/backup metals feed where available
ALPHA_VANTAGE_API_KEY=

# Generic broker/LME feed webhook or REST endpoint, if you have one
CUSTOM_LME_FEED_URL=
CUSTOM_LME_FEED_KEY=

# --- MCX (India commodity futures) ---
# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Angel One SmartAPI
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_ID=
SMARTAPI_PASSWORD=
SMARTAPI_TOTP_SECRET=

# --- Forex (LME USD/tonne -> INR/kg conversion) ---
# exchangerate.host (free, no key required by default) is used unless overridden
FOREX_API_KEY=
FOREX_PROVIDER=exchangerate.host

# --- App / scheduler config ---
DATABASE_URL=sqlite:///./commodity_dashboard.db
LME_FETCH_INTERVAL_MINUTES=30
MCX_FETCH_INTERVAL_MINUTES=15
NALCO_FETCH_INTERVAL_HOURS=6
FOREX_FETCH_INTERVAL_MINUTES=60

# CORS - comma separated origins allowed to hit the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
